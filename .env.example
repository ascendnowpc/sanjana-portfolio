# Supabase — see DATABASE.md for the full setup walkthrough.
# Leave these blank and the site runs entirely on the bundled local content
# in src/data/performances.ts (that is the default, and it works offline).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare R2 — the public base URL of the media bucket. See MEDIA.md.
# This is the live bucket (sanjana-portfolio-media). It is a public read-only
# hostname, not a secret. Media keys are appended to it, so /media/posters/x.jpg
# is fetched from <base>/media/posters/x.jpg.
# Leave it blank and files are served from public/ instead — that is what makes
# local dev and offline builds work without the bucket.
# Swap in a custom domain here when one is set up; r2.dev is rate-limited by
# Cloudflare and not intended for production traffic.
VITE_R2_PUBLIC_URL=https://pub-7b43e56065be4b36a1057c48e7f327af.r2.dev

# Legacy alias for any other CDN (Cloudinary, Bunny, Mux...). Only read when
# VITE_R2_PUBLIC_URL is empty.
VITE_MEDIA_BASE_URL=

# Used by `npm run media:upload` only — never bundled into the client.
R2_BUCKET=sanjana-portfolio-media

# ---------------------------------------------------------------------------
# Editing the site from the site — see EDITING.md.
#
# Everything below is read by the two functions under api/ and never by the
# client, so none of it is bundled. Without them the editor still works and
# edits stay in the editor's browser; with them, Publish commits the content to
# this repository and Replace uploads media to the bucket.
# ---------------------------------------------------------------------------

# The real lock. Checked on the server by api/publish.ts and api/upload.ts.
# NOT the password in the panel — that one ships in the bundle and is public.
# Make this a different, longer one.
ADMIN_PASSWORD=

# A fine-grained token with Contents: read and write on this repository, and
# nothing else. This is what commits src/content/published.json.
GITHUB_TOKEN=

# owner/repo. Optional on Vercel, which exports it from the build.
GITHUB_REPO=

# Which branch a publish commits to. Defaults to the branch this deploy was
# built from, so publishing from a preview URL commits to the preview's branch.
PUBLISH_BRANCH=

# Cloudflare R2, for uploading media from the browser. An R2 API token with
# Object Read & Write, scoped to the one bucket. The bucket also has to allow
# PUT from the site's origin — see infra/r2-cors.json and MEDIA.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Where the in-browser ffmpeg loads its core from. Left blank it comes from
# jsDelivr, which is the usual case; set it to self-host those two files.
VITE_FFMPEG_CORE_URL=
